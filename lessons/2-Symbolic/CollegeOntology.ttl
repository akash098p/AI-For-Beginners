@prefix uni: <http://www.example.com/university.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

uni: a owl:Ontology .

# ============================================================
# Classes
# ============================================================

uni:Person a owl:Class .

uni:Student a owl:Class ;
    rdfs:subClassOf uni:Person ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty uni:enrolledIn ;
        owl:someValuesFrom uni:Course
    ] .

uni:Professor a owl:Class ;
    rdfs:subClassOf uni:Person ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty uni:teaches ;
        owl:someValuesFrom uni:Course
    ] .

uni:Staff a owl:Class ;
    rdfs:subClassOf uni:Person .

uni:Course a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty uni:taughtBy ;
        owl:someValuesFrom uni:Professor
    ] .

uni:Department a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty uni:offersCourse ;
        owl:someValuesFrom uni:Course
    ] .

uni:Building a owl:Class .

uni:Library a owl:Class ;
    rdfs:subClassOf uni:Building .

uni:Lab a owl:Class ;
    rdfs:subClassOf uni:Building .

uni:LectureHall a owl:Class ;
    rdfs:subClassOf uni:Building .

uni:Dormitory a owl:Class ;
    rdfs:subClassOf uni:Building .

uni:Faculty a owl:Class ;
    rdfs:subClassOf uni:Building .

# ============================================================
# Object Properties
# ============================================================

# Enrollment relationships
uni:enrolledIn a owl:ObjectProperty ;
    rdfs:domain uni:Student ;
    rdfs:range uni:Course .

uni:teaches a owl:ObjectProperty ;
    rdfs:domain uni:Professor ;
    rdfs:range uni:Course .

uni:taughtBy a owl:ObjectProperty ;
    owl:inverseOf uni:teaches ;
    rdfs:domain uni:Course ;
    rdfs:range uni:Professor .

# Department relationships
uni:belongsToDepartment a owl:ObjectProperty ;
    rdfs:domain uni:Person ;
    rdfs:range uni:Department .

uni:offersCourse a owl:ObjectProperty ;
    rdfs:domain uni:Department ;
    rdfs:range uni:Course .

uni:headedBy a owl:ObjectProperty ;
    rdfs:domain uni:Department ;
    rdfs:range uni:Professor .

# Building relationships
uni:locatedIn a owl:ObjectProperty ;
    rdfs:domain uni:Course ;
    rdfs:range uni:Building .

uni:containsLab a owl:ObjectProperty ;
    rdfs:domain uni:Department ;
    rdfs:range uni:Lab .

# Prerequisite relationships
uni:hasPrerequisite a owl:ObjectProperty ;
    rdfs:domain uni:Course ;
    rdfs:range uni:Course .

# Advisor relationships
uni:advisedBy a owl:ObjectProperty ;
    rdfs:domain uni:Student ;
    rdfs:range uni:Professor .

# Property chain axioms for inference
# A student's department is the department of the course they are enrolled in
uni:memberOfDepartment a owl:ObjectProperty ;
    owl:propertyChainAxiom ( uni:enrolledIn uni:belongsToDepartment ) .

# A professor's department is the department that offers their course
uni:memberOfDepartment a owl:ObjectProperty ;
    owl:propertyChainAxiom ( uni:teaches uni:belongsToDepartment ) .

# ============================================================
# Data Properties
# ============================================================

uni:name a owl:DatatypeProperty ;
    rdfs:domain uni:Person ;
    rdfs:range xsd:string .

uni:studentID a owl:DatatypeProperty ;
    rdfs:domain uni:Student ;
    rdfs:range xsd:string .

uni:employeeID a owl:DatatypeProperty ;
    rdfs:domain uni:Person ;
    rdfs:range xsd:string .

uni:courseCode a owl:DatatypeProperty ;
    rdfs:domain uni:Course ;
    rdfs:range xsd:string .

uni:credits a owl:DatatypeProperty ;
    rdfs:domain uni:Course ;
    rdfs:range xsd:integer .

uni:buildingName a owl:DatatypeProperty ;
    rdfs:domain uni:Building ;
    rdfs:range xsd:string .

uni:capacity a owl:DatatypeProperty ;
    rdfs:domain uni:LectureHall ;
    rdfs:range xsd:integer .

uni:year a owl:DatatypeProperty ;
    rdfs:domain uni:Student ;
    rdfs:range xsd:integer .

uni:birthdate a owl:DatatypeProperty ;
    rdfs:domain uni:Person ;
    rdfs:range xsd:date .

# ============================================================
# Individuals - Departments
# ============================================================

uni:ComputerScience a uni:Department ;
    rdfs:label "Computer Science Department" ;
    uni:headedBy uni:GitanjaliMondal .

uni:Mathematics a uni:Department ;
    rdfs:label "Mathematics Department" ;
    uni:headedBy uni:AnantaDoshwami .

uni:Physics a uni:Department ;
    rdfs:label "Physics Department" ;
    uni:headedBy uni:BiswajitMahapatra .

